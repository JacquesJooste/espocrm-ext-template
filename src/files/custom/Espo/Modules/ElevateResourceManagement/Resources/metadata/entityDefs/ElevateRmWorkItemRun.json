{
  "fields": {
    "name": {"type":"varchar","required":true,"maxLength":180},
    "workBlockRun": {"type":"link","required":true},
    "sourceWorkItem": {"type":"link"},
    "scheduledBlock": {"type":"link"},
    "nameSnapshot": {"type":"varchar","required":true,"maxLength":180},
    "descriptionSnapshot": {"type":"text"},
    "estimatedSeconds": {"type":"int","required":true,"min":60},
    "actualElapsedSeconds": {"type":"int","default":0,"readOnly":true},
    "actualLabourSeconds": {"type":"int","default":0,"readOnly":true},
    "sequence": {"type":"int","default":0},
    "status": {
      "type":"enum",
      "options":["Planned","In Progress","Completed","Cancelled"],
      "default":"Planned",
      "displayAsLabel":true,
      "index":true
    },
    "completedAt": {"type":"datetime","readOnly":true}
  },
  "links": {
    "workBlockRun": {"type":"belongsTo","entity":"ElevateRmWorkBlockRun","foreign":"workItemRuns"},
    "sourceWorkItem": {"type":"belongsTo","entity":"ElevateRmWorkItem"},
    "scheduledBlock": {"type":"belongsTo","entity":"ElevateRmScheduledBlock"},
    "timeEntries": {"type":"hasMany","entity":"ElevateRmTimeEntry","foreign":"workItemRun"}
  },
  "indexes": {
    "runSequence": {"columns":["workBlockRunId","sequence"]},
    "scheduleStatus": {"columns":["scheduledBlockId","status"]}
  },
  "optimisticConcurrencyControl": true,
  "transactionalSave": true
}

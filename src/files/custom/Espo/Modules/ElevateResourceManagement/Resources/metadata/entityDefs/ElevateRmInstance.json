{
  "fields": {
    "name": {"type":"varchar","required":true,"maxLength":150},
    "mode": {"type":"enum","options":["Standard","Project"],"default":"Standard","required":true},
    "status": {"type":"enum","options":["Active","Archived"],"default":"Active","required":true,"displayAsLabel":true},
    "targetEntityType": {"type":"varchar","required":true,"maxLength":100,"index":true,"view":"elevate-resource-management:views/fields/target-entity-type","tooltip":true},
    "eligibilityCriteria": {"type":"jsonArray","default":[],"view":"elevate-resource-management:views/fields/json-array","tooltip":true},
    "identifierField": {"type":"varchar","required":true,"default":"name","view":"elevate-resource-management:views/fields/target-field","mappingKind":"scalar","tooltip":true},
    "nameField": {"type":"varchar","required":true,"default":"name","view":"elevate-resource-management:views/fields/target-field","mappingKind":"scalar","tooltip":true},
    "statusField": {"type":"varchar","required":true,"default":"status","view":"elevate-resource-management:views/fields/target-field","mappingKind":"status","tooltip":true},
    "resourceField": {"type":"varchar","required":true,"default":"assignedUser","view":"elevate-resource-management:views/fields/target-field","mappingKind":"resource","tooltip":true},
    "accountField": {"type":"varchar","view":"elevate-resource-management:views/fields/target-field","mappingKind":"account","tooltip":true},
    "contactField": {"type":"varchar","view":"elevate-resource-management:views/fields/target-field","mappingKind":"contact","tooltip":true},
    "inProgressStatus": {"type":"varchar","required":true,"view":"elevate-resource-management:views/fields/target-status","tooltip":true},
    "completedStatusList": {"type":"jsonArray","default":[],"view":"elevate-resource-management:views/fields/target-status-list","tooltip":true},
    "addTimeLogsTargetStatus": {"type":"varchar","view":"elevate-resource-management:views/fields/target-status"},
    "readyForBillingTargetStatus": {"type":"varchar","view":"elevate-resource-management:views/fields/target-status"},
    "invoicedTargetStatus": {"type":"varchar","view":"elevate-resource-management:views/fields/target-status"},
    "defaultWorkBlockIds": {"type":"jsonArray","default":[],"view":"elevate-resource-management:views/fields/json-array","tooltip":true},
    "showStreamEntries": {"type":"bool","default":false},
    "capacityConflictMode": {"type":"enum","options":["Warn","Block"],"default":"Warn"},
    "outsideHoursMode": {"type":"enum","options":["Warn","Block"],"default":"Warn"},
    "revision": {"type":"int","default":1,"readOnly":true}
  },
  "indexes": {
    "targetStatus":{"columns":["targetEntityType","status"]},
    "instanceName":{"columns":["name"]}
  },
  "optimisticConcurrencyControl": true,
  "transactionalSave": true,
  "collection": {"orderBy":"name","order":"asc"}
}

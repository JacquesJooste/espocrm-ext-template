{
  "fields": {
    "name": {"type":"varchar","required":true},
    "workPackage": {"type":"link","required":true},
    "workBlockRun": {"type":"link"},
    "workItemRun": {"type":"link"},
    "scheduledBlock": {"type":"link"},
    "status": {"type":"enum","options":["Active","Completed","Abandoned"],"default":"Active","index":true},
    "startedAt": {"type":"datetime","required":true},
    "endedAt": {"type":"datetime"},
    "lastCheckpointAt": {"type":"datetime","required":true},
    "attendeeIds": {"type":"jsonArray","required":true,"view":"elevate-resource-management:views/fields/json-array"},
    "earlyCheckIn": {"type":"bool","default":false},
    "clientActionId": {"type":"varchar","required":true,"maxLength":64,"index":true},
    "revision": {"type":"int","default":1,"readOnly":true}
  },
  "links": {
    "workPackage": {"type":"belongsTo","entity":"ElevateRmWorkPackage","foreign":"sessions"},
    "workBlockRun": {"type":"belongsTo","entity":"ElevateRmWorkBlockRun"},
    "workItemRun": {"type":"belongsTo","entity":"ElevateRmWorkItemRun"},
    "scheduledBlock": {"type":"belongsTo","entity":"ElevateRmScheduledBlock"}
  },
  "indexes": {
    "packageStatus":{"columns":["workPackageId","status"]},
    "uniqueAction":{"columns":["clientActionId"],"unique":true}
  },
  "optimisticConcurrencyControl": true,
  "transactionalSave": true
}

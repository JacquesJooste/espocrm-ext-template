{
  "fields": {
    "name": {"type":"varchar","required":true,"maxLength":180},
    "status": {"type":"enum","options":["Planned","In Progress","Completed","Cancelled"],"default":"Planned","displayAsLabel":true,"audited":true},
    "dateStart": {"type":"datetime","required":true,"audited":true},
    "dateEnd": {"type":"datetime","required":true,"after":"dateStart","audited":true},
    "isAllDay": {"type":"bool","default":false},
    "workPackage": {"type":"link","required":true},
    "template": {"type":"link"},
    "instance": {"type":"link","required":true},
    "activitiesSnapshot": {"type":"jsonArray","default":[],"view":"elevate-resource-management:views/fields/json-array"},
    "estimatedSeconds": {"type":"int","required":true,"min":60},
    "sequence": {"type":"int","default":0},
    "milestoneKind": {"type":"enum","options":["Normal","Deadline","Achievement","Delivery"],"default":"Normal"},
    "completedAt": {"type":"datetime","readOnly":true},
    "users": {"type":"linkMultiple","required":true},
    "revision": {"type":"int","default":1,"readOnly":true},
    "description": {"type":"text"}
  },
  "links": {
    "workPackage": {"type":"belongsTo","entity":"ElevateRmWorkPackage","foreign":"scheduledBlocks"},
    "template": {"type":"belongsTo","entity":"ElevateRmWorkBlockTemplate"},
    "instance": {"type":"belongsTo","entity":"ElevateRmInstance"},
    "users": {"type":"hasMany","entity":"User","foreign":"elevateRmScheduledBlocks","relationName":"elevateRmScheduledBlockUser"}
  },
  "indexes": {
    "packageSequence":{"columns":["workPackageId","sequence"]},
    "dateRange":{"columns":["dateStart","dateEnd"]},
    "instanceStatus":{"columns":["instanceId","status"]}
  },
  "optimisticConcurrencyControl": true,
  "transactionalSave": true,
  "collection": {"orderBy":"dateStart","order":"asc"}
}
